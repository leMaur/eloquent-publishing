includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - src/Database/Schema/Blueprint

    tmpDir: build/phpstan

    ignoreErrors:
        # Publishes is the package's public API: it is only ever used by the models of
        # applications that install the package, never by a class inside the analysed paths.
        -
            identifier: trait.unused
            path: src/Database/Eloquent/Publishes.php
